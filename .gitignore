# ============================================================================
# ClaudeScienceHackathon_2026 — root .gitignore
# Global protections layered on top of each entry's own .gitignore.
# ============================================================================

# --- Data: never commit (PhysioNet / NHANES / GEO / GWAS data-use agreements) ---
**/data/ptbxl/
**/data/nhanes/
**/work/
*.dat
*.hea
*.XPT
*.xpt
*.vcf
*.vcf.gz
*.bed
*.bigwig
*.bw
*.h5
*.hdf5

# --- Large model checkpoints (re-train from src/, or fetch from a release) ---
*.pt
*.pth
*.ckpt
*.onnx

# --- Archives (packages are shipped as source trees, not zips) ---
*.zip
*.tar.gz
*.tgz

# --- Secrets / environment ---
.env
.env.*
*.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
dist/
build/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.bbl
*.blg
*.toc
*.synctex.gz

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
nul
.vscode/
.idea/
*.swp
*.swo
*~
