# ============================================================================
# ClaudeScienceHackathon_2026 root .gitignore
# Global protections layered on top of each entry's own .gitignore.
# ============================================================================

# --- Source data: never commit unless already tracked as an explicitly licensed demo asset ---
**/data/ptbxl/
**/data/nhanes/
**/work/
*.dat
*.hea
*.XPT
*.xpt
*.vcf
*.vcf.gz
*.bed
*.bigwig
*.bw
*.h5
*.hdf5
**/AABC2_PRIVATE/
**/raw_never_share/
**/*participant_visit_manifest*
**/neuromotionvector_scores.parquet
**/*outcomes*.parquet
**/*.locked

# --- Large model checkpoints (ignored by default) ---
# Approved frozen demo .pt files are explicitly unignored and checksummed in
# electrical-body-clock/RELEASE_MANIFEST.sha256.
*.pt
*.pth
*.ckpt
*.onnx

# --- Archives (packages are shipped as source trees, not zips) ---
*.zip
*.tar.gz
*.tgz

# --- Secrets / environment ---
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
*password*
*token*.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
dist/
build/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- LaTeX build artifacts ---
*.aux
*.log
*.out
*.bbl
*.blg
*.toc
*.synctex.gz

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
nul
.vscode/
.idea/
*.swp
*.swo
*~
